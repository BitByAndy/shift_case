{
  "name": "shift-case",
  "displayName": "Shift Case",
  "description": "Toggle selected text between UPPERCASE and lowercase with a single keybinding",
  "version": "0.1.0",
  "publisher": "bitbyandy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BitByAndy/shift_case.git"
  },
  "bugs": {
    "url": "https://github.com/BitByAndy/shift_case/issues"
  },
  "homepage": "https://github.com/BitByAndy/shift_case#readme",
  "keywords": [
    "case",
    "uppercase",
    "lowercase",
    "toggle case",
    "text transform",
    "formatter"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onCommand:shift-case.toggleCase"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shift-case.toggleCase",
        "title": "Toggle Case"
      }
    ],
    "keybindings": [
      {
        "command": "shift-case.toggleCase",
        "key": "shift+alt+u",
        "mac": "shift+alt+u",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "shift-case.toggleCase",
          "when": "editorIsOpen"
        }
      ],
      "editor/context": [
        {
          "command": "shift-case.toggleCase",
          "when": "editorTextFocus",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:web": "node esbuild.js --web-tests && vscode-test-web --browser=chromium --headless --extensionDevelopmentPath=. --extensionTestsPath=dist/test/web/index.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "assert": "^2.1.0",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "mocha": "^10.8.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
